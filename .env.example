# Copy to .env for local runs. Never commit .env or a real key.

# Which provider leads: groq | gemini | openrouter | none (deterministic replies
# only). Leave it unset to pick automatically: the first key present, preferring
# groq, then gemini, then openrouter.
LLM_PROVIDER=groq

# --- Groq (free tier, OpenAI-compatible, fastest of the free options) ---
# Free key from https://console.groq.com/keys . Its free tier has an explicit
# quota, unlike the OpenRouter key this project started with, which reported
# `total_credits: 0` while pointed at a *paid* model - so it worked on an
# undocumented allowance and would have failed silently when that ran out.
GROQ_API_KEY=replace-with-your-key
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenRouter (OpenAI-compatible; widest model choice) ---
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Google Gemini (used directly, or as the backup) ---
GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# How much hidden reasoning to allow on a direct Gemini call. 0 means "answer
# immediately", which is what a two-sentence child reply wants. Some models
# (for example gemini-3.5-flash-lite) reject 0 with a 400; use `none` for those.
GEMINI_THINKING_BUDGET=0

# Whichever key is present but not chosen as the lead becomes a backup inside one
# shared time budget. Set explicitly to override the automatic pairing.
# LLM_FALLBACK_PROVIDER=gemini

# Hard ceiling on one model call, in milliseconds. Exceeding it uses the
# deterministic fallback reply instead. 1800ms keeps the worst case under the
# two-second target while still letting the model speak on almost every turn.
LLM_TIMEOUT_MS=1800
LLM_MAX_TOKENS=48

# --- Speech ---
# edge  = the built-in neural voice (no key, no billing account needed)
# none  = disable server speech; the browser voice is used instead
SPEECH_PROVIDER=edge
# Any voice name from `edge-tts --list-voices`, for example en-GB-SoniaNeural.
SPEECH_VOICE=en-US-AvaMultilingualNeural
# How long to wait for audio before giving up and letting the client fall back.
SPEECH_TIMEOUT_MS=8000

# Optional: point at a different curriculum file.
# CURRICULUM_PATH=./data/curriculum.json

# Server port for local runs.
PORT=8080
